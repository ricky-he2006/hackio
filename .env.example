# Runs with local, deterministic agents when no key is configured.
PORT=3000
HOST=127.0.0.1
AGENT_PROVIDER=local
# Choose a model available in your account. Keys stay on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Gemini search grounding is opt-in; check your account's quotas/pricing first.
ENABLE_WEB_SEARCH=false
# Optional: change before sharing beyond your team; applied at database creation.
DEMO_PASSWORD=disco2026
# Hostnames this server answers to besides localhost/127.0.0.1 (comma-separated). Required when deployed.
ALLOWED_HOSTS=
# Encryption key for the database (32 random bytes, base64). Leave empty locally to auto-generate data/disco.sqlite.key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
