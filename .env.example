# Runs with local, deterministic agents when no key is configured.
PORT=3000
HOST=127.0.0.1
AGENT_PROVIDER=local
# Choose a model available in your account. Keys stay on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Gemini search grounding is opt-in; check your account's quotas/pricing first.
ENABLE_WEB_SEARCH=false
# Optional: change before sharing beyond your team; applied at database creation.
DEMO_PASSWORD=disco2026
# Optional: Google Maps Embed API key for the place-page map (free API; restrict the key to the Maps Embed API
# and your site's HTTP referrers). Without it, the page shows an OpenStreetMap snippet and an Open in Google Maps link.
GOOGLE_MAPS_EMBED_KEY=
# Optional: server-only Google key for venue photos and street addresses (Places API (New); needs billing).
# Restrict it to Places API (New). Never reuse the browser Embed key. Without it, cards show map snippets.
GOOGLE_PLACES_KEY=
